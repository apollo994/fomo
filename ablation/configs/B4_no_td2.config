// Ablation B4 — both TD2 coding filters OFF (input and projected).
// 1.02 rather than B2/B3's 1.01: same effect (PSAURON scores never exceed 1.0), but a
// different task hash, so B2 and B4 never compute the same task in the shared workDir
// at the same time when they run side by side.
process {
    withName: 'FOMO:PREPROCESSING:TD2_NONCODING:TD2_CODING_FILTER' {
        ext.args = '--psauron-min 1.02'
    }
    withName: 'FOMO:PROJECTION:TD2_NONCODING_PROJ:TD2_CODING_FILTER' {
        ext.args = '--psauron-min 1.02'
    }
}
