// Ablation B2 — input (source-side) TD2 coding filter OFF.
// A PSAURON cut-off above the score's maximum (1.0) means no ORF is ever called coding,
// so TD2_CODING_FILTER keeps every record. TD2_PREDICT still runs (cost unchanged); only
// its verdict is ignored. The filtered annotation (= benchmarking reference) changes too.
process {
    withName: 'FOMO:PREPROCESSING:TD2_NONCODING:TD2_CODING_FILTER' {
        ext.args = '--psauron-min 1.01'
    }
}
