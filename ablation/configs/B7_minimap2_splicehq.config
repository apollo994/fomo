// Ablation B7 — minimap2 preset splice:hq (-C5 -O6,24 -B4: stricter scoring meant for
// high-accuracy same-species cDNA) instead of splice. Same k/w, so the -x splice index is
// reused as is.
process {
    withName: 'FOMO:PROJECTION:MINIMAP2_ALIGN' {
        ext.args = '-x splice:hq -uf --cs'
    }
}
