// nf-test: stub-run scenarios of the whole pipeline (tests/pipeline). Stub tests need a container
// profile (`--profile +singularity` or `+docker`): the software-version `eval` outputs run in
// stub mode too.
config {
    testsDir "tests/pipeline"
    libDir "tests/pipeline/lib"
    workDir ".nf-test"
    configFile "tests/pipeline/nextflow.config"
    profile "test"
}
