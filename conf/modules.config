process {
    withName: 'FOMO:PREPROCESSING:FILTER_TRANSCRIPT' {
        ext.prefix = { "${meta.id}.${meta.feature_type}" }
    }

    withName: 'FOMO:PREPROCESSING:EXTRACT_SEQUENCES' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.${meta.feature_type}.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:GFF_TO_GENE_BED' {
        ext.prefix = { "${meta.id}" }
    }

    withName: 'FOMO:PREPROCESSING:BEDTOOLS_COMPLEMENT' {
        ext.prefix = { "${meta.id}.intergenic" }
    }

    withName: 'FOMO:PREPROCESSING:RELOCATE_LOCI' {
        ext.prefix = { "${meta.id}.${meta.feature_type}" }
    }

    withName: 'FOMO:PREPROCESSING:EXTRACT_DECOY_SEQUENCES' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.${meta.feature_type}.decoy.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:RENAME_FASTA_HEADERS' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.spliced" }
    }

    // ── STATS subworkflow ────────────────────────────────────────────────────
    withName: 'FOMO:STATS:GUNZIP_RAW_GFF' {
        ext.prefix = { "${meta.id}.raw" }
    }

    withName: 'FOMO:STATS:AGAT_SPSTATISTICS' {
        ext.prefix = { [
            meta.id,
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
        // Raw whole-genome GFFs are larger than filtered/decoy — bump resources
        memory = { meta.kind == 'raw' ? 8.GB : 2.GB }
        time   = { meta.kind == 'raw' ? 1.h  : 15.min }
    }

    withName: 'FOMO:STATS:AGAT_TO_MQC' {
        ext.prefix = { [
            meta.id,
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
    }

    withName: 'FOMO:STATS:SEQKIT_STATS' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.spliced" }
    }

    withName: 'FOMO:STATS:SEQKIT_TO_MQC' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}" }
    }
}
