process {
    // ── PREPROCESSING ────────────────────────────────────────────────────────
    withName: 'FOMO:PREPROCESSING:FILTER_TRANSCRIPT' {
        // The only place isoform selection happens: the benchmarking reference is derived
        // from this output, so the two cannot drift.
        ext.args = params.longest_isoform ? '--longest' : ''
    }

    withName: 'FOMO:PREPROCESSING:EXTRACT_SEQUENCES' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.${meta.feature_type}.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:BEDTOOLS_COMPLEMENT' {
        ext.prefix = { "${meta.id}.intergenic" }
    }

    withName: 'FOMO:PREPROCESSING:EXTRACT_DECOY_SEQUENCES' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.${meta.feature_type}.decoy.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:RENAME_FASTA_HEADERS' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.spliced" }
    }

    // TD2 on the source lncRNA: LongOrfs flags (ext.args) and Predict flags (ext.args2)
    withName: 'FOMO:PREPROCESSING:TD2_NONCODING:TD2_PREDICT' {
        ext.args  = '-S --complete-orfs-only'
        ext.args2 = '--complete-orfs-only'
    }
    withName: 'FOMO:PREPROCESSING:TD2_NONCODING:TD2_CODING_FILTER' {
        ext.args        = { "--psauron-min ${params.td2_psauron_min}" }
        ext.stage       = 'input'
        ext.prefix      = { "${meta.id}.lnc_RNA" }
        ext.sample_name = { "${meta.id}" }
    }

    // GFF_STATS* selectors are `$`-anchored: withName is a regex find, so 'GFF_STATS' would
    // also match GFF_STATS_TO_MQC.
    withName: 'FOMO:PREPROCESSING:GFF_STATS$' {
        ext.prefix = { [
            meta.id,
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
    }

    withName: 'FOMO:PREPROCESSING:GFF_STATS_TO_MQC$' {
        ext.role         = 'source'
        ext.genes_output = true
        ext.prefix = { [
            meta.id,
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
        // The ordering prefix sorts the rows raw → lncRNA → decoy_lncRNA → mRNA → decoy_mRNA.
        ext.sample_name = {
            def order =
                meta.kind == 'raw'                              ? '1_raw'           :
                !meta.decoy && meta.feature_type == 'lnc_RNA'   ? '2_lncRNA'        :
                 meta.decoy && meta.feature_type == 'lnc_RNA'   ? '3_decoy_lncRNA'  :
                !meta.decoy && meta.feature_type == 'mRNA'      ? '4_mRNA'          :
                 meta.decoy && meta.feature_type == 'mRNA'      ? '5_decoy_mRNA'    :
                                                                  'unknown'
            "${meta.id}.${order}"
        }
    }

    withName: 'FOMO:PREPROCESSING:SEQKIT_STATS' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.spliced" }
    }

    // ── BENCHMARKING ─────────────────────────────────────────────────────────
    // The '.target' segment keeps a 'both' species' target-side rows apart from its
    // source-side rows in the same table.
    withName: 'FOMO:BENCHMARKING:GFF_STATS_TARGET$' {
        ext.prefix = { [
            meta.id, 'target',
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
    }

    withName: 'FOMO:BENCHMARKING:GFF_STATS_TARGET_TO_MQC$' {
        ext.role         = 'target'
        ext.genes_output = true
        ext.prefix = { [
            meta.id, 'target',
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
        // Same ordering as the source side; `_target` keeps a species' two sides adjacent.
        ext.sample_name = {
            def order =
                meta.kind == 'raw'                ? '1_raw'    :
                meta.feature_type == 'lnc_RNA'    ? '2_lncRNA' :
                meta.feature_type == 'mRNA'       ? '4_mRNA'   :
                                                    'unknown'
            "${meta.id}.${order}_target"
        }
    }

    withName: 'FOMO:BENCHMARKING:GFFCOMPARE_BATCH' {
        ext.args = '-M --no-merge'
    }

    // ── PROJECTION ───────────────────────────────────────────────────────────
    withName: 'FOMO:PROJECTION:MERGE_SOURCE_FASTA' {
        ext.prefix = { "allsources.${meta.gtype}" }
    }

    withName: 'FOMO:PROJECTION:MINIMAP2_INDEX' {
        // The preset must match MINIMAP2_ALIGN's. -I 20G keeps genomes up to 20 Gb in a
        // single-part index: a multi-part index loses the @SQ header and per-genome MAPQ, and
        // --split-prefix cannot be combined with --cs. Memory then scales with the whole genome.
        ext.args = '-x splice -I 20G'
    }

    withName: 'FOMO:PROJECTION:MINIMAP2_ALIGN' {
        // Spliced, transcript-strand alignment (-uf); --cs keeps the reference difference string.
        ext.args   = '-x splice -uf --cs'
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
    }

    withName: 'FOMO:PROJECTION:BAM_TO_GFF' {
        // The pre-TD2 model set; FILTER_ALLMODELS writes the published `.raw.gff3`.
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.unfiltered" }
        ext.args   = params.include_single_exon ? '--include-single-exon' : ''
    }

    // TD2 on the projected lncRNA: once per target, on the all-sources model set
    withName: 'FOMO:PROJECTION:EXTRACT_PROJECTED_LNC' {
        ext.args   = '-w'
        ext.prefix = { "${meta.target_id}.allModels.lnc_RNA.raw" }
    }
    withName: 'FOMO:PROJECTION:TD2_NONCODING_PROJ:TD2_PREDICT' {
        ext.args  = '-S --complete-orfs-only'
        ext.args2 = '--complete-orfs-only'
    }
    withName: 'FOMO:PROJECTION:TD2_NONCODING_PROJ:TD2_CODING_FILTER' {
        ext.args        = { "--psauron-min ${params.td2_psauron_min}" }
        ext.stage       = 'projected'
        ext.prefix      = { "${meta.target_id}.allModels.lnc_RNA.raw" }
        ext.sample_name = { "${meta.target_id}.allModels" }
    }
    withName: 'FOMO:PROJECTION:FILTER_ALLMODELS' {
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
    }

    withName: 'FOMO:PROJECTION:SPLIT_GFF_BY_SOURCE' {
        ext.args = { "--name-template '${meta.target_id}.from_{source}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.projected.gff3'" }
    }

    withName: 'FOMO:PROJECTION:SAMTOOLS_STATS' {
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
    }

    withName: 'FOMO:PROJECTION:SAMTOOLS_TO_MQC' {
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
        // Same ordering token as the projected GFF stats rows.
        ext.sample_name = {
            def order =
                !meta.decoy && meta.feature_type == 'lnc_RNA' ? '1_lncRNA'        :
                 meta.decoy && meta.feature_type == 'lnc_RNA' ? '2_decoy_lncRNA'  :
                !meta.decoy && meta.feature_type == 'mRNA'    ? '3_mRNA'          :
                 meta.decoy && meta.feature_type == 'mRNA'    ? '4_decoy_mRNA'    :
                                                                'unknown'
            "${meta.target_id}.allModels.${order}"
        }
    }

    // ── CURATION ─────────────────────────────────────────────────────────────
    withName: 'FOMO:CURATION:CURATE_MODELS' {
        ext.args = { "--min-species ${params.curate_min_species}" }
        // `--curate false` skips the task; `ext.when` keeps the process (and its selectors) defined.
        ext.when = { params.curate }
    }

    // ── REPORTING and RUN_SUMMARY ────────────────────────────────────────────
    // `$`-anchored, so the per-target settings never reach the MULTIQC_RUN_SUMMARY alias.
    withName: 'FOMO:REPORTING:MULTIQC$' {
        ext.args   = ''
        ext.prefix = 'multiqc_report'
    }

    withName: 'FOMO:REPORTING:GFFCOMPARE_TO_SCATTER' {
        ext.prefix = { "${meta.target_id}.gffcompare_accuracy" }
    }

    withName: 'FOMO:RUN_SUMMARY:RUN_SUMMARY_TABLES$' {
        ext.args = { "--include-mrna ${params.include_mrna} " +
                     "--include-decoy ${params.include_decoy} " +
                     "--psauron-min ${params.td2_psauron_min}" }
    }

    withName: 'FOMO:RUN_SUMMARY:MULTIQC_RUN_SUMMARY$' {
        ext.args   = ''
        ext.prefix = 'fomo_run_summary'
    }

    // ══ Result publishing ════════════════════════════════════════════════════
    // Grouped by destination: targets/<target>/<dir>/ (keyed on meta.target_id),
    // sources/<source>/<dir>/ (keyed on meta.id) and summary/ (static paths: no target
    // dimension). A process that loses its key publishes to targets/null/ or sources/null/.
    // The selectors are `$`-anchored so that no other alias matches them.

    // targets/<target>/alignment/: <target>.allModels.<gtype>.raw.bam(.csi)
    withName: '.*:MINIMAP2_ALIGN$' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target_id}/alignment" },
            mode: params.publish_dir_mode,
        ]
    }

    // targets/<target>/annotation/: <target>.allModels.<gtype>.raw.gff3 and
    // <target>.from_<source>.<gtype>.projected.gff3
    withName: '.*:(FILTER_ALLMODELS|SPLIT_GFF_BY_SOURCE)$' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target_id}/annotation" },
            mode: params.publish_dir_mode,
        ]
    }

    // targets/<target>/gffcompare/: *.stats *.tracking *.loci *.tmap *.refmap
    withName: '.*:GFFCOMPARE_BATCH$' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target_id}/gffcompare" },
            mode: params.publish_dir_mode,
        ]
    }

    // targets/<target>/curated/: the curated GFF3, the merged GFF3 (annotated targets) and
    // the curation report; the *_mqc.tsv copies feed MultiQC only.
    withName: '.*:CURATE_MODELS$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/curated" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_mqc.tsv') ? null : filename },
        ]
    }

    // targets/<target>/multiqc/
    withName: '.*:MULTIQC$' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target_id}/multiqc" },
            mode: params.publish_dir_mode,
        ]
    }

    // sources/<source>/annotation/: <source>.<ft>.filtered.gff3, the projected transcripts and
    // the benchmarking reference of a 'both' species
    withName: '.*:FILTER_ANNOTATION$' {
        publishDir = [
            path: { "${params.outdir}/sources/${meta.id}/annotation" },
            mode: params.publish_dir_mode,
        ]
    }

    // summary/tables/ and summary/multiqc/
    withName: '.*:RUN_SUMMARY_TABLES$' {
        publishDir = [
            path: "${params.outdir}/summary/tables",
            mode: params.publish_dir_mode,
        ]
    }

    withName: '.*:MULTIQC_RUN_SUMMARY$' {
        publishDir = [
            path: "${params.outdir}/summary/multiqc",
            mode: params.publish_dir_mode,
        ]
    }
}
