process {
    withName: 'FOMO:PREPROCESSING:FILTER_TRANSCRIPT' {
        ext.prefix = { "${meta.id}.${meta.feature_type}" }
    }

    withName: 'FOMO:PREPROCESSING:EXTRACT_SEQUENCES' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.${meta.feature_type}.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:GFF_TO_GENE_BED' {
        ext.prefix = { "${meta.id}" }
    }

    withName: 'FOMO:PREPROCESSING:BEDTOOLS_COMPLEMENT' {
        ext.prefix = { "${meta.id}.intergenic" }
    }

    withName: 'FOMO:PREPROCESSING:RELOCATE_LOCI' {
        ext.prefix = { "${meta.id}.${meta.feature_type}" }
    }

    withName: 'FOMO:PREPROCESSING:EXTRACT_DECOY_SEQUENCES' {
        ext.args   = '-w'
        ext.prefix = { "${meta.id}.${meta.feature_type}.decoy.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:RENAME_FASTA_HEADERS' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.spliced" }
    }

    // ── PREPROCESSING TD2 coding-potential filter (input lncRNA) ──────────────
    withName: 'FOMO:PREPROCESSING:TD2_NONCODING:TD2_PREDICT' {
        // LongOrfs flags (ext.args) + Predict flags (ext.args2): match td2_results test.
        ext.args  = '-S --complete-orfs-only'
        ext.args2 = '--complete-orfs-only'
    }
    withName: 'FOMO:PREPROCESSING:TD2_NONCODING:TD2_CODING_FILTER' {
        ext.args        = { "--psauron-min ${params.td2_psauron_min}" }
        ext.stage       = 'input'
        ext.prefix      = { "${meta.id}.lnc_RNA" }
        ext.sample_name = { "${meta.id}" }
    }
    withName: 'FOMO:PREPROCESSING:FILTER_LNC_GFF' {
        // FILTER_GFF_BY_ID emits ${prefix}.gff3 (the prefix owns the whole name), so
        // `.filtered` is spelled out here to keep this file's name stable.
        ext.prefix = { "${meta.id}.lnc_RNA.filtered" }
    }

    // ── PREPROCESSING stat producers ────────────────────────────────────────
    // No resource overrides for GFF_STATS anywhere: gff-feature-stats holds a
    // flat ~20 MB RSS and finishes a 660 MB GFF in ~1 s, so the process_single
    // defaults (6 GB / 10 min) are already orders of magnitude more than needed.
    // The AGAT predecessor needed 8-12 GB and up to 2 h here.
    //
    // NOTE: every GFF_STATS* selector below is `$`-anchored. withName matching is
    // a regex *find*, so an unanchored 'GFF_STATS' would also match
    // 'GFF_STATS_TO_MQC' (verified: it leaks ext settings across the pair).
    withName: 'FOMO:PREPROCESSING:GFF_STATS$' {
        ext.prefix = { [
            meta.id,
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
    }

    withName: 'FOMO:PREPROCESSING:GFF_STATS_TO_MQC$' {
        ext.role         = 'source'
        ext.section_id   = 'gffstats_input'
        // Gene-category table only for input annotations (see GFF_STATS_TO_MQC).
        ext.genes_output = true
        ext.prefix = { [
            meta.id,
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
        // Row identifier carries a 1..5 ordering prefix so the input table
        // displays rows as raw → lncRNA → decoy_lncRNA → mRNA → decoy_mRNA
        // under MultiQC's default alphabetical sort.
        ext.sample_name = {
            def order =
                meta.kind == 'raw'                              ? '1_raw'           :
                !meta.decoy && meta.feature_type == 'lnc_RNA'   ? '2_lncRNA'        :
                 meta.decoy && meta.feature_type == 'lnc_RNA'   ? '3_decoy_lncRNA'  :
                !meta.decoy && meta.feature_type == 'mRNA'      ? '4_mRNA'          :
                 meta.decoy && meta.feature_type == 'mRNA'      ? '5_decoy_mRNA'    :
                                                                  'unknown'
            "${meta.id}.${order}"
        }
    }

    withName: 'FOMO:PREPROCESSING:SEQKIT_STATS' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.spliced" }
    }

    withName: 'FOMO:PREPROCESSING:SEQKIT_TO_MQC' {
        ext.prefix = { "${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}" }
    }

    // ── BENCHMARKING stat producers ──────────────────────────────────────────
    // The '.target' segment is not decoration. With role 'both' the SAME species
    // produces a source row and a target row in the SAME gffstats_input table, and
    // they are different data: the source-side lncRNA has been TD2 coding-filtered,
    // the target reference deliberately has not. Without the segment both sides
    // write `<species>.raw_gffstats_input_mqc.tsv` under the row key
    // `<species>.1_raw` and one silently clobbers the other.
    withName: 'FOMO:BENCHMARKING:GFF_STATS_TARGET$' {
        ext.prefix = { [
            meta.id, 'target',
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
    }

    withName: 'FOMO:BENCHMARKING:GFF_STATS_TARGET_TO_MQC$' {
        ext.role         = 'target'
        ext.section_id   = 'gffstats_input'
        ext.genes_output = true
        ext.prefix = { [
            meta.id, 'target',
            meta.kind == 'raw'      ? 'raw'
          : meta.kind == 'filtered' ? meta.feature_type
          :                           "${meta.feature_type}.decoy"
        ].join('.') }
        // Target has no decoys — only raw / lncRNA / mRNA. Numeric prefix
        // matches the source-side ordering so source + target rows interleave
        // by `kind` per species; the trailing `_target` disambiguates the two
        // sides for a role-'both' species while keeping them adjacent under
        // MultiQC's alphabetical sort (X.1_raw, X.1_raw_target, X.2_lncRNA, …).
        ext.sample_name = {
            def order =
                meta.kind == 'raw'                ? '1_raw'    :
                meta.feature_type == 'lnc_RNA'    ? '2_lncRNA' :
                meta.feature_type == 'mRNA'       ? '4_mRNA'   :
                                                    'unknown'
            "${meta.id}.${order}_target"
        }
    }

    // ── REPORTING subworkflow ────────────────────────────────────────────────
    // One report per target. The filename stays constant because publishDir puts
    // each under results/targets/<target>/multiqc/ (see nextflow.config).
    withName: 'FOMO:REPORTING:MULTIQC' {
        ext.args   = ''
        ext.prefix = 'multiqc_report'
    }

    withName: 'FOMO:REPORTING:GFFCOMPARE_TO_SCATTER' {
        ext.prefix = { "${meta.target_id}.gffcompare_accuracy" }
    }

    // ── PROJECTION subworkflow ───────────────────────────────────────────────
    withName: 'FOMO:PROJECTION:GUNZIP_TARGET' {
        ext.prefix = { "${meta.id}" }
    }

    withName: 'FOMO:PROJECTION:MERGE_SOURCE_FASTA' {
        // One all-sources FASTA per gene type — target-independent, so no target_id
        // in the name (and none in the meta at this point).
        ext.prefix = { "allsources.${meta.gtype}" }
    }

    withName: 'FOMO:PROJECTION:MINIMAP2_INDEX' {
        // MUST match the preset used at align time; otherwise minimap2 silently
        // rebuilds the in-memory index with the align-time preset.
        ext.args   = '-x splice'
        ext.prefix = { "${meta.id}.splice" }
    }

    withName: 'FOMO:PROJECTION:MINIMAP2_ALIGN' {
        // Module prepends `-a` when bam_format=true → reproduces `minimap2 -ax splice -uf`.
        // -uf forces forward-strand reads (correct for spliced transcript exons).
		// --cs reports reference sequence and allows downstream analysis such as maligno
        ext.args   = '-x splice -uf --cs'
        // One BAM per (target, gene type), holding every source. meta.id is the
        // literal 'allModels' from here down; the source lives in each read name.
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
    }

    withName: 'FOMO:PROJECTION:BAM_TO_GFF' {
        // Intermediate: this is the pre-TD2 model set. FILTER_ALLMODELS produces the
        // published `.raw.gff3`, so the two can never collide on name.
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.unfiltered" }
        ext.args   = params.include_single_exon ? '--include-single-exon' : ''
    }

    // ── PROJECTION TD2 coding-potential filter (projected lncRNA) ─────────────
    // Runs once per target on the all-sources model set, not once per source.
    withName: 'FOMO:PROJECTION:EXTRACT_PROJECTED_LNC' {
        // Extract spliced transcript FASTA from the projected GFF3 + target genome.
        ext.args   = '-w'
        ext.prefix = { "${meta.target_id}.allModels.lnc_RNA.raw" }
    }
    withName: 'FOMO:PROJECTION:TD2_NONCODING_PROJ:TD2_PREDICT' {
        ext.args  = '-S --complete-orfs-only'
        ext.args2 = '--complete-orfs-only'
    }
    withName: 'FOMO:PROJECTION:TD2_NONCODING_PROJ:TD2_CODING_FILTER' {
        ext.args        = { "--psauron-min ${params.td2_psauron_min}" }
        ext.stage       = 'projected'
        ext.prefix      = { "${meta.target_id}.allModels.lnc_RNA.raw" }
        ext.sample_name = { "${meta.target_id}.allModels" }
    }
    withName: 'FOMO:PROJECTION:FILTER_ALLMODELS' {
        // The published raw model set. Every gene type comes out of here — the
        // non-lncRNA classes just carry an empty drop list — so there is exactly one
        // producer of `<target>.allModels.<gtype>.raw.gff3`.
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
    }

    withName: 'FOMO:PROJECTION:SPLIT_GFF_BY_SOURCE' {
        // The template MUST agree with the prefix/suffix arithmetic that re-keys the
        // split files back to per-source metas in projection.nf — change one and the
        // other breaks with an out-of-range substring, not a silent mismatch.
        ext.args = { "--name-template '${meta.target_id}.from_{source}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.projected.gff3'" }
    }

    withName: 'FOMO:PROJECTION:GFFCOMPARE_COMBINE' {
        // One consensus GTF per gene type → <target>.allModels.<gtype>.combined.gtf
        // (gffcompare appends the .combined.gtf suffix itself).
        ext.prefix = { "${meta.target_id}.allModels.${meta.gtype}" }
    }

    withName: 'FOMO:PROJECTION:COMBINED_GTF_TO_GFF' {
        // The published collapsed consensus (default gffread output = GFF3).
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.collapsed" }
    }

    withName: 'FOMO:PROJECTION:SAMTOOLS_STATS' {
        // Default prefix is just meta.id ('allModels'), the same for every target —
        // make it unique per (target, feature_type, decoy). These are now
        // whole-alignment metrics: the merged BAM has no per-source breakdown, so the
        // per-source view comes from GFF_STATS_PROJECTED instead.
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
    }

    withName: 'FOMO:PROJECTION:SAMTOOLS_TO_MQC' {
        ext.prefix = { "${meta.target_id}.allModels.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.raw" }
        // Row identifier matches the GFF stats projection ordering convention so
        // both tables can be cross-referenced by sample name.
        ext.sample_name = {
            def order =
                !meta.decoy && meta.feature_type == 'lnc_RNA' ? '1_lncRNA'        :
                 meta.decoy && meta.feature_type == 'lnc_RNA' ? '2_decoy_lncRNA'  :
                !meta.decoy && meta.feature_type == 'mRNA'    ? '3_mRNA'          :
                 meta.decoy && meta.feature_type == 'mRNA'    ? '4_decoy_mRNA'    :
                                                                'unknown'
            "${meta.target_id}.allModels.${order}"
        }
    }

    withName: 'FOMO:PROJECTION:GFF_STATS_PROJECTED$' {
        ext.prefix = { "${meta.target_id}.from_${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.projected" }
    }

    withName: 'FOMO:PROJECTION:GFF_STATS_PROJECTED_TO_MQC$' {
        ext.role        = 'projection'
        ext.section_id  = 'gffstats_projection'
        ext.prefix = { "${meta.target_id}.from_${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.projected" }
        // Projection table is sorted within each (target, source) group by
        // a 1..4 ordering prefix: lncRNA → decoy_lncRNA → mRNA → decoy_mRNA.
        ext.sample_name = {
            def order =
                !meta.decoy && meta.feature_type == 'lnc_RNA' ? '1_lncRNA'        :
                 meta.decoy && meta.feature_type == 'lnc_RNA' ? '2_decoy_lncRNA'  :
                !meta.decoy && meta.feature_type == 'mRNA'    ? '3_mRNA'          :
                 meta.decoy && meta.feature_type == 'mRNA'    ? '4_decoy_mRNA'    :
                                                                'unknown'
            "${meta.target_id}.from_${meta.id}.${order}"
        }
    }

    // ── BENCHMARKING subworkflow ─────────────────────────────────────────────
    withName: 'FOMO:BENCHMARKING:GUNZIP_TARGET_GFF' {
        ext.prefix = { "${meta.id}.raw" }
    }

    withName: 'FOMO:BENCHMARKING:FILTER_TARGET' {
        // Same prefix as PREPROCESSING:FILTER_TRANSCRIPT, and with role 'both' both
        // run for the same species. Harmless — separate processes, separate work
        // dirs, neither published — and they are NOT interchangeable: the source
        // copy is TD2 coding-filtered downstream, this reference copy must not be.
        ext.prefix = { "${meta.id}.${meta.feature_type}" }
    }

    withName: 'FOMO:BENCHMARKING:GFFCOMPARE' {
        ext.args   = '-M --no-merge'
        ext.prefix = { "${meta.target_id}.from_${meta.id}.${meta.feature_type}${meta.decoy ? '.decoy' : ''}.gffcompare" }
    }

    // ── CONSENSUS_TOP subworkflow ────────────────────────────────────────────
    withName: 'FOMO:CONSENSUS_TOP:SELECT_TOP_SOURCES' {
        // One ranking per target → <target>.top_sources.csv. This process IS
        // published, so the prefix must carry the target or every target's ranking
        // lands on the same published filename.
        ext.args   = { "--n ${params.top_consensus_n}" }
        ext.prefix = { "${meta.target_id}" }
    }

    withName: 'FOMO:CONSENSUS_TOP:SUBSET_GFF_BY_SOURCE' {
        // The keep-list itself is the third module input; only the output name comes
        // from here. The published raw top-N model set.
        ext.args = { "--name ${meta.target_id}.top3.${meta.feature_type}.raw.gff3" }
    }

    withName: 'FOMO:CONSENSUS_TOP:GFFCOMPARE_COMBINE_TOP' {
        // One consensus GTF per gene type → <target>.top3.<gtype>.combined.gtf
        ext.prefix = { "${meta.target_id}.top3.${meta.gtype}" }
    }

    withName: 'FOMO:CONSENSUS_TOP:COMBINED_TOP_GTF_TO_GFF' {
        // The published collapsed top-N consensus.
        ext.prefix = { "${meta.target_id}.top3.${meta.feature_type}.collapsed" }
    }

    // meta.id below is 'top3_raw' or 'top3_collapsed' — BOTH are scored now, so
    // every name here must carry it or the two collide on one filename.
    withName: 'FOMO:CONSENSUS_TOP:GFF_STATS_TOP$' {
        ext.prefix = { "${meta.target_id}.from_${meta.id}.${meta.feature_type}.projected" }
    }

    withName: 'FOMO:CONSENSUS_TOP:GFF_STATS_TOP_TO_MQC$' {
        ext.role        = 'projection'
        ext.section_id  = 'gffstats_projection'
        ext.prefix = { "${meta.target_id}.from_${meta.id}.${meta.feature_type}.projected" }
        // Same 1..4 ordering convention as per-source projections so the top3
        // rows sort consistently in the projection GFF stats table.
        ext.sample_name = {
            def order =
                meta.feature_type == 'lnc_RNA' ? '1_lncRNA' :
                meta.feature_type == 'mRNA'    ? '3_mRNA'   :
                                                 'unknown'
            "${meta.target_id}.from_${meta.id}.${order}"
        }
    }

    withName: 'FOMO:CONSENSUS_TOP:GFFCOMPARE_TOP' {
        ext.args   = '-M --no-merge'
        ext.prefix = { "${meta.target_id}.from_${meta.id}.${meta.feature_type}.gffcompare" }
    }

    // ══ Result publishing ════════════════════════════════════════════════════
    // Grouped by DESTINATION, not by process. Every deliverable is target-scoped,
    // so each publishes under targets/<target>/<dir>/ — one subtree per target.
    //
    // Four rules to keep:
    //  1. `meta.target_id` is the per-target segment. A process that loses the key
    //     publishes to `targets/null/`, which is the symptom to grep for.
    //  2. Selectors here are `.*:NAME$`-shaped, unlike the fully-qualified
    //     `withName: 'FOMO:PROJECTION:…'` blocks above. That is deliberate: the
    //     publishing rule is the same wherever an aliased process is instantiated.
    //     Nextflow merges settings across all matching selectors, and only these
    //     blocks set publishDir, so there is no conflict with the ext.* blocks.
    //  3. The trailing `$` is load-bearing. `GFFCOMPARE$` must NOT match
    //     `GFFCOMPARE_COMBINE` / `GFFCOMPARE_COMBINE_TOP` — those are intermediate
    //     steps whose .combined.gtf is republished as GFF3 by the GFFREAD aliases.
    //  4. BAM_TO_GFF is deliberately absent: its output is the PRE-TD2 model set.
    //     The published `.raw.gff3` comes out of FILTER_ALLMODELS.
    //
    // Sizing: one BAM per (target, gene type) rather than per (target, source, gene
    // type), so 20 targets × F × D publishes ~40 BAMs — the ~1600 of the
    // pre-single-mapping layout is gone, and with it the disk caveat.

    // targets/<target>/alignment/ — <target>.allModels.<gtype>.raw.bam(.bai)
    withName: '.*:MINIMAP2_ALIGN$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/alignment" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // targets/<target>/annotation/ — all six GFF3 kinds, from five processes:
    //   FILTER_ALLMODELS        <target>.allModels.<gtype>.raw.gff3
    //   COMBINED_GTF_TO_GFF     <target>.allModels.<gtype>.collapsed.gff3
    //   SPLIT_GFF_BY_SOURCE     <target>.from_<source>.<gtype>.projected.gff3  (N files)
    //   SUBSET_GFF_BY_SOURCE    <target>.top3.<ft>.raw.gff3
    //   COMBINED_TOP_GTF_TO_GFF <target>.top3.<ft>.collapsed.gff3
    // The names are disjoint by construction (see the ext.prefix / ext.args blocks
    // above), so they share one directory without collision.
    withName: '.*:(FILTER_ALLMODELS|COMBINED_GTF_TO_GFF|SPLIT_GFF_BY_SOURCE|SUBSET_GFF_BY_SOURCE|COMBINED_TOP_GTF_TO_GFF)$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/annotation" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // targets/<target>/gffcompare/ — *.stats *.tracking *.loci *.tmap *.refmap
    withName: '.*:(GFFCOMPARE|GFFCOMPARE_TOP)$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/gffcompare" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // targets/<target>/select_top_sources/ — <target>.top_sources.csv
    withName: '.*:SELECT_TOP_SOURCES$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/select_top_sources" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // targets/<target>/multiqc/ — multiqc_report.html + multiqc_report_data/
    withName: '.*:MULTIQC$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/multiqc" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
