// ext.* per process, then result publishing. Every selector is `.*:NAME$`: withName is a regex
// find, so an unanchored name would also match its longer aliases (GFF_STATS → GFF_STATS_TARGET).
process {
    // ── PREPROCESSING ────────────────────────────────────────────────────────
    withName: '.*:FILTER_TRANSCRIPT$' {
        // The only place isoform selection happens: the benchmarking reference is derived
        // from this output, so the two cannot drift.
        ext.args = params.longest_isoform ? '--longest' : ''
    }

    withName: '.*:EXTRACT_(DECOY_)?SEQUENCES$' {
        ext.prefix = { "${meta.id}.${meta.track}.spliced" }
    }

    withName: '.*:BEDTOOLS_COMPLEMENT$' {
        ext.prefix = { "${meta.id}.intergenic" }
    }

    withName: '.*:RELOCATE_LOCI$' {
        ext.args = { "--seed ${params.relocate_seed} --decoy-cap ${params.decoy_cap}" }
    }

    withName: '.*:RENAME_FASTA_HEADERS$' {
        ext.prefix = { "${meta.id}.${meta.track}.spliced" }
    }

    withName: '.*:FILTER_ANNOTATION$' {
        ext.prefix = { "${meta.id}.${meta.track}.filtered" }
    }

    // TD2 on the source lncRNA (meta.stage 'input') and on each target's projected lncRNA
    // ('projected'): LongOrfs flags (ext.args) and Predict flags (ext.args2).
    withName: '.*:TD2_PREDICT$' {
        ext.args  = '-S --complete-orfs-only'
        ext.args2 = '--complete-orfs-only'
    }
    withName: '.*:TD2_CODING_FILTER$' {
        ext.args        = { "--psauron-min ${params.td2_psauron_min}" }
        ext.prefix      = { meta.stage == 'projected' ? "${meta.target_id}.allModels.lnc_RNA.raw" : "${meta.id}.lnc_RNA" }
    }

    // Annotation stats records: <id>.raw, <id>.<track> (a pure target's raw annotation too).
    withName: '.*:GFF_STATS(_TARGET)?$' {
        ext.prefix = { "${meta.id}.${meta.kind == 'raw' ? 'raw' : meta.track}" }
    }

    withName: '.*:SEQKIT_STATS$' {
        ext.prefix = { "${meta.id}.${meta.track}.spliced" }
    }

    // ── BENCHMARKING ─────────────────────────────────────────────────────────
    withName: '.*:GFFCOMPARE_BATCH$' {
        ext.args = '-M --no-merge'
    }

    // ── PROJECTION ───────────────────────────────────────────────────────────
    withName: '.*:MERGE_SOURCE_FASTA$' {
        ext.prefix = { "allsources.${meta.track}" }
    }

    withName: '.*:MINIMAP2_INDEX$' {
        // The preset must match MINIMAP2_ALIGN's. -I 20G keeps genomes up to 20 Gb in a
        // single-part index: a multi-part index loses the @SQ header and per-genome MAPQ, and
        // --split-prefix cannot be combined with --cs. Memory then scales with the whole genome.
        ext.args = '-x splice -I 20G'
    }

    withName: '.*:MINIMAP2_ALIGN$' {
        // Spliced, transcript-strand alignment (-uf); --cs keeps the reference difference string.
        ext.args   = '-x splice -uf --cs'
        ext.prefix = { "${meta.target_id}.allModels.${meta.track}.raw" }
    }

    withName: '.*:BAM_TO_GFF$' {
        // The pre-TD2 model set; FILTER_ALLMODELS writes the published `.raw.gff3`.
        ext.prefix = { "${meta.target_id}.allModels.${meta.track}.unfiltered" }
        ext.args   = params.include_single_exon ? '--include-single-exon' : ''
    }

    // The projected lncRNA go through TD2 once per target, on the all-sources model set.
    withName: '.*:EXTRACT_PROJECTED_LNC$' {
        ext.prefix = { "${meta.target_id}.allModels.lnc_RNA.raw" }
    }
    withName: '.*:FILTER_ALLMODELS$' {
        ext.prefix = { "${meta.target_id}.allModels.${meta.track}.raw" }
    }

    withName: '.*:SPLIT_GFF_BY_SOURCE$' {
        ext.args = { "--name-template '${meta.target_id}.from_{source}.${meta.track}.projected.gff3' --aggregate-id allModels_raw" }
    }

    withName: '.*:SAMTOOLS_STATS$' {
        ext.prefix = { "${meta.target_id}.allModels.${meta.track}.raw" }
    }

    // ── CURATION ─────────────────────────────────────────────────────────────
    withName: '.*:CURATE_MODELS$' {
        ext.args = { "--min-species ${params.curate_min_species}" }
    }

    // ── REPORTING and RUN_SUMMARY ────────────────────────────────────────────
    withName: '.*:MULTIQC$' {
        ext.args   = ''
        ext.prefix = 'multiqc_report'
    }

    withName: '.*:RUN_SUMMARY_TABLES$' {
        ext.args = { "--include-mrna ${params.include_mrna} " +
                     "--include-decoy ${params.include_decoy} " +
                     "--psauron-min ${params.td2_psauron_min}" }
    }

    withName: '.*:MULTIQC_RUN_SUMMARY$' {
        ext.args   = ''
        ext.prefix = 'fomo_run_summary'
    }

    // ══ Result publishing ════════════════════════════════════════════════════
    // Grouped by destination: targets/<target>/<dir>/ (keyed on meta.target_id),
    // sources/<source>/<dir>/ (keyed on meta.id) and summary/ (static paths: no target
    // dimension). A process that loses its key publishes to targets/null/ or sources/null/.
    // Only deliverables publish (publishDir's `enabled` takes a static boolean only): data
    // records, manifests and MultiQC tables are not saved.

    // targets/<target>/alignment/: <target>.allModels.<track>.raw.bam(.csi)
    withName: '.*:MINIMAP2_ALIGN$' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target_id}/alignment" },
            mode: params.publish_dir_mode,
        ]
    }

    // targets/<target>/annotation/: <target>.allModels.<track>.raw.gff3 and
    // <target>.from_<source>.<track>.projected.gff3
    withName: '.*:(FILTER_ALLMODELS|SPLIT_GFF_BY_SOURCE)$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/annotation" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.manifest.tsv') ? null : filename },
        ]
    }

    // targets/<target>/gffcompare/: *.stats *.tracking *.loci *.tmap *.refmap
    withName: '.*:GFFCOMPARE_BATCH$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/gffcompare" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.data.json') ? null : filename },
        ]
    }

    // targets/<target>/curated/: the curated GFF3, the merged GFF3 (annotated targets) and
    // the curation report
    withName: '.*:CURATE_MODELS$' {
        publishDir = [
            path:   { "${params.outdir}/targets/${meta.target_id}/curated" },
            mode:   params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('_mqc.tsv') || filename.endsWith('.data.json') ? null : filename },
        ]
    }

    // targets/<target>/multiqc/
    withName: '.*:MULTIQC$' {
        publishDir = [
            path: { "${params.outdir}/targets/${meta.target_id}/multiqc" },
            mode: params.publish_dir_mode,
        ]
    }

    // sources/<source>/annotation/: <source>.<ft>.filtered.gff3, the projected transcripts and
    // the benchmarking reference of a 'both' species
    withName: '.*:FILTER_ANNOTATION$' {
        publishDir = [
            path: { "${params.outdir}/sources/${meta.id}/annotation" },
            mode: params.publish_dir_mode,
        ]
    }

    // summary/tables/ and summary/multiqc/
    withName: '.*:RUN_SUMMARY_TABLES$' {
        publishDir = [
            path: "${params.outdir}/summary/tables",
            mode: params.publish_dir_mode,
        ]
    }

    withName: '.*:MULTIQC_RUN_SUMMARY$' {
        publishDir = [
            path: "${params.outdir}/summary/multiqc",
            mode: params.publish_dir_mode,
        ]
    }

    // Identity of a task's data records (fomo-data/1): the meta keys that name what was measured.
    // It must stay after every withName block: the config parser scopes the ext.* of a withName
    // that follows a process-level ext.* to the process level (tests/test_repo_conventions.py).
    ext.identity = {
        groovy.json.JsonOutput.toJson([
            species: meta.id,
            side:    meta.target_id ? 'target' : 'source',
            target:  meta.target_id,
            track:   meta.track,
            label:   meta.label,
            order:   meta.order,
            kind:    meta.kind,
        ].findAll { _key, value -> value != null })
    }
}
