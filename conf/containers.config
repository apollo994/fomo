// Every container image, selected by the module's one `img_*` label. Images are immutable:
// Wave and BioContainers tags, or a registry digest (python, ubuntu; digests of the multi-arch
// index, taken 2026-10-15). Singularity gets the prebuilt image where one is published.

process {
    withLabel: 'img_python' {
        container = 'python@sha256:50cfccc707e8721201ee018bfd7f6a85d8eacf49c4f9f75833a2aba09a10411f'   // python:3.11
    }
    withLabel: 'img_ubuntu' {
        container = 'ubuntu@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401'   // ubuntu:22.04
    }
    withLabel: 'img_samtools' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/8c/8c5d2818c8b9f58e1fba77ce219fdaf32087ae53e857c4a496402978af26e78c/data'
            : 'community.wave.seqera.io/library/htslib_samtools:1.23.1--5b6bb4ede7e612e5' }
    }
    withLabel: 'img_minimap2' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/40/40a39951375e148d401c77e200777053cb628a4095bda598f7d41db08cbbfa4c/data'
            : 'community.wave.seqera.io/library/minimap2:2.30--dde6b0c5fbc82ebd' }
    }
    withLabel: 'img_minimap2_samtools' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/37/37671219cfd244eb9b33db9345d3543ffd83037419a1c57f4648aace493ec2c2/data'
            : 'community.wave.seqera.io/library/minimap2_samtools:b09096fc890429ce' }
    }
    withLabel: 'img_gffread' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/gffread:0.12.7--hdcf5f25_4'
            : 'quay.io/biocontainers/gffread:0.12.7--hdcf5f25_4' }
    }
    withLabel: 'img_bedtools' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/bedtools:2.31.1--hf5e1c6e_0'
            : 'quay.io/biocontainers/bedtools:2.31.1--hf5e1c6e_0' }
    }
    withLabel: 'img_seqkit' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/seqkit:2.9.0--h9ee0642_0'
            : 'quay.io/biocontainers/seqkit:2.9.0--h9ee0642_0' }
    }
    withLabel: 'img_multiqc' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/multiqc:1.35--pyhdfd78af_1'
            : 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_1' }
    }
    // python 3.11 + gffcompare 0.12.6 + gffread 0.12.7 (the versions of img_gffcompare and
    // img_gffread).
    withLabel: 'img_curate' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'oras://community.wave.seqera.io/library/python_gffcompare_gffread:970e511c83295d93'
            : 'community.wave.seqera.io/library/python_gffcompare_gffread:8f0a261560fe9c3b' }
    }
    // td2 1.1.0 with CPU torch; PSAURON uses a GPU only with a CUDA-torch image and `--nv`.
    withLabel: 'img_td2' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'oras://community.wave.seqera.io/library/td2:1.1.0--357f46c1cbbeed20'
            : 'community.wave.seqera.io/library/td2:1.1.0--76046a413a4219c1' }
    }
    withLabel: 'img_gffcompare' {
        container = { workflow.containerEngine in ['singularity', 'apptainer']
            ? 'https://depot.galaxyproject.org/singularity/gffcompare:0.12.6--h9f5acd7_0'
            : 'quay.io/biocontainers/gffcompare:0.12.6--h9f5acd7_0' }
    }
}
