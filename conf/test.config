params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'All-vs-all test over single-chromosome subsampled Lycaena assemblies'

    // 1 row 'both' (alciphron: donor + benchmarked target), 1 pure 'target' WITH a gff3
    // (hippothoe: projected onto and curated against its own annotation, not benchmarked —
    // plans/22), 1 pure 'source' (thersamon). T = 2, S = 2 → 4 target×source pairs.
    // assets/samplesheet_target_noref.csv is the same sheet with hippothoe's gff3 left empty
    // (the reference-less curation path): --input assets/samplesheet_target_noref.csv.
    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = 'results'

    // lncRNA only — the deliverable track, F = 1, D = 1 → 2 alignments (F·D·T). The mRNA
    // positive control and the decoy FDR baseline are development instruments, not
    // part of what the test needs to prove, and enabling both quadrupled the task
    // count (48 alignments). Add --include_mrna / --include_decoy on the command
    // line when you specifically want to exercise those branches.
}

process {
    resourceLimits = [
        cpus:   2,
        memory: '4.GB',
        time:   '30.min'
    ]
}
