params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'All-vs-all test over single-chromosome subsampled Lycaena assemblies'

    // 2 rows 'both' (→ self-pairs), 1 pure 'target' with an EMPTY gff3 (→ projected
    // but not benchmarked), 2 pure 'source'. T = 3, S = 4 → 12 target×source pairs.
    // Use -profile test_single for the single-target regression path.
    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = 'results'

    // lncRNA only — the deliverable track, F = 1, D = 1 → 12 alignments. The mRNA
    // positive control and the decoy FDR baseline are development instruments, not
    // part of what the test needs to prove, and enabling both quadrupled the task
    // count (48 alignments). Add --include_mrna / --include_decoy on the command
    // line when you specifically want to exercise those branches.
}

process {
    resourceLimits = [
        cpus:   2,
        memory: '4.GB',
        time:   '30.min'
    ]
}
