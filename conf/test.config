params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'All-vs-all test over single-chromosome subsampled Lycaena assemblies'

    // alciphron 'both' (donor and benchmarked target), hippothoe a pure 'target' with a gff3
    // (curated against it, not benchmarked), thersamon a pure 'source': S = 2, T = 2.
    // assets/samplesheet_target_noref.csv is the same sheet with hippothoe's gff3 left empty.
    input  = "${projectDir}/assets/samplesheet.csv"
    outdir = 'results'

    // lncRNA only (F = 1, D = 1). Add --include_mrna / --include_decoy to exercise those tracks.
}

process {
    resourceLimits = [
        cpus:   2,
        memory: '4.GB',
        time:   '30.min'
    ]
}
