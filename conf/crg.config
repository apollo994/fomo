profiles {
    crg {
        workDir = '/nfs/scratch01/rg/fzanarello/work_fomo'

        process {
            executor       = 'slurm'
            queue          = 'genoa64'
            cache          = 'lenient'
            clusterOptions = '--account=phyloencode'

            withLabel: 'big_mem' {
                cpus   = 8
                memory = '32 GB'
                time   = '2h'
            }
            withLabel: 'small' {
                cpus   = 2
                memory = '4 GB'
                time   = '30m'
            }

            // ── TD2 on GPU (optional) ──────────────────────────────────────────
            // TD2_PREDICT runs via a conda directive (CPU torch by default, set in
            // modules/local/td2_predict.nf). PSAURON auto-uses a GPU when the env's
            // torch is CUDA-enabled, so to run it on a CRG GPU node: fill in the GPU
            // partition + gres below and uncomment. Until then TD2 stays on CPU.
            // NOTE: a process-level clusterOptions overrides the global one, so the
            //       --account flag is repeated here.
            // withName: '.*:TD2_PREDICT' {
            //     queue          = 'GPU_PARTITION'                       // TODO(CRG): GPU partition/queue name
            //     clusterOptions = '--account=phyloencode --gres=gpu:1'  // TODO(CRG): confirm gres syntax
            //     accelerator    = 1
            //     conda          = 'bioconda::td2=1.1.0 conda-forge::pytorch-gpu'
            // }
        }

		singularity.enabled    = true
        singularity.autoMounts = true
        executor.pollInterval = '30 sec'
    }
}
