// CRG cluster: site settings only (resources are in conf/base.config). NXF_WORK overrides the
// work directory.
workDir = System.getenv('NXF_WORK') ?: '/nfs/scratch01/rg/fzanarello/work_fomo'

process {
    executor       = 'slurm'
    queue          = 'genoa64'
    cache          = 'lenient'
    clusterOptions = '--account=phyloencode'

    resourceLimits = [
        cpus:   64,
        memory: 200.GB,
        time:   24.h
    ]

    // At most 96 index jobs at once: the site's per-user limit of the QOS that 1 h jobs land in.
    withName: '.*:MINIMAP2_INDEX$' {
        maxForks = 96
    }
}

singularity.enabled    = true
singularity.autoMounts = true

// Most tasks finish in seconds: poll often, and keep a submission backlog larger than the
// running-job limit so a freed slot is refilled at once.
executor {
    pollInterval = '5 sec'
    queueSize    = 500
    dumpInterval = '1 min'
}
