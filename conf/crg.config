profiles {
    crg {
        workDir = '/nfs/scratch01/rg/fzanarello/work_fomo'

        process {
            executor       = 'slurm'
            queue          = 'genoa64'
            cache          = 'lenient'
            clusterOptions = '--account=phyloencode'

            resourceLimits = [
                cpus:   64,
                memory: 200.GB,
                time:   24.h
            ]

            // Indexing with -x splice needs ~10 GB per Gb of genome, whatever the thread count
            // (minimap2 indexes with at most three threads).
            withName: 'FOMO:PROJECTION:MINIMAP2_INDEX' {
                cpus   = 3
                memory = { 32.GB * task.attempt }
                time   = { 1.h   * task.attempt }
                // At most 96 index jobs at once: the site's per-user limit of the QOS
                // that 1 h jobs land in.
                maxForks = 96
            }

            // Alignment memory follows the target genome size, so each retry doubles it.
            withName: 'FOMO:PROJECTION:MINIMAP2_ALIGN' {
                memory     = { 24.GB * Math.pow(2, task.attempt - 1) }
                maxRetries = 2
            }

            // One task digests every MultiQC input of the run; large runs stage tens of
            // thousands of files.
            withName: 'FOMO:RUN_SUMMARY:RUN_SUMMARY_TABLES' {
                cpus   = 1
                memory = { 8.GB * task.attempt }
                time   = { 2.h  * task.attempt }
            }
        }

        singularity.enabled    = true
        singularity.autoMounts = true

        // Most tasks finish in seconds: poll often, and keep a submission backlog larger than
        // the running-job limit so a freed slot is refilled at once.
        executor {
            pollInterval = '5 sec'
            queueSize    = 500
            dumpInterval = '1 min'
        }
    }
}
