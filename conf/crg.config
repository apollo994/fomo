profiles {
    crg {
        workDir = '/nfs/scratch01/rg/fzanarello/work_fomo'

        process {
            executor       = 'slurm'
            queue          = 'genoa64'
            cache          = 'lenient'
            clusterOptions = '--account=phyloencode'

            // Lift the local-dev ceiling so retry memory escalation works on the cluster.
            resourceLimits = [
                cpus:   64,
                memory: 200.GB,
                time:   24.h
            ]

            // Indexing a ~3 GB genome with -x splice needs ~25-30 GB; process_low (12 GB)
            // is OOM-killed on every attempt when base.config caps at 14 GB.
            withName: 'FOMO:PROJECTION:MINIMAP2_INDEX' {
                cpus   = { 8     * task.attempt }
                memory = { 32.GB * task.attempt }
                time   = { 1.h   * task.attempt }
                // The one fat process here: 8 cpu / 32 GB, where everything else is
                // process_single (1 cpu / 2 GB). At queueSize = 500 the old
                // 100-slot window no longer limits it, so it gets an explicit cap.
                //
                // 96 is a deliberate "index as fast as the cluster allows" choice:
                // 96 x 8 = 768 of genoa64's 868 cpus and 96 x 32 GB = 3.0 of its
                // 4.95 TB, i.e. close to the whole partition. It also coincides with
                // the SLURM-side ceiling — the 1 h `time` here auto-selects QOS
                // `vshort`, whose MaxJobsPU is 96 — so this mostly stops Nextflow
                // from queueing work SLURM will not run anyway. Note MINIMAP2_ALIGN
                // (time = 1 h in base.config) lands in the SAME QOS and competes for
                // those 96 slots. Lower this to ~24 to be a better cluster citizen;
                // T = 1260 indexes at ~68 s each is ~15 min at 96 vs ~60 min at 24.
                //
                // Keep this here, NOT in conf/base.config: crg.config is included
                // FIRST, and when two withName selectors match the LATER one wins
                // regardless of specificity (see conf/base.config:80-92), so a
                // broad base.config selector would silently override this.
                maxForks = 96
            }

            withLabel: 'big_mem' {
                cpus   = 8
                memory = '32 GB'
                time   = '2h'
            }
            withLabel: 'small' {
                cpus   = 2
                memory = '4 GB'
                time   = '30m'
            }

            // ── TD2 on GPU (optional) ──────────────────────────────────────────
            // TD2_PREDICT now runs from a container (CPU torch, see
            // modules/local/td2_predict.nf). PSAURON auto-uses a GPU when torch is
            // CUDA-enabled, so to run it on a CRG GPU node: fill in the GPU partition
            // + gres below and uncomment. Until then TD2 stays on CPU.
            // NOTE: overriding `conda` no longer switches torch — the container is
            //       what executes. Build a CUDA-torch image (e.g. via
            //       https://seqera.io/containers from `bioconda::td2=1.1.0
            //       conda-forge::pytorch-gpu`) and point `container` at it, plus
            //       `--nv` so apptainer exposes the device.
            // NOTE: a process-level clusterOptions overrides the global one, so the
            //       --account flag is repeated here.
            // withName: '.*:TD2_PREDICT' {
            //     queue            = 'GPU_PARTITION'                       // TODO(CRG): GPU partition/queue name
            //     clusterOptions   = '--account=phyloencode --gres=gpu:1'  // TODO(CRG): confirm gres syntax
            //     accelerator      = 1
            //     container        = 'oras://community.wave.seqera.io/library/...'  // TODO(CRG): CUDA-torch build
            //     containerOptions = '--nv'
            // }
        }

		singularity.enabled    = true
        singularity.autoMounts = true
        // ── Executor tuning ──────────────────────────────────────────────────
        // Measured from run `agitated_legentil` (see plans/17_scheduling_efficiency.md):
        // the median task did 4.8 s of work inside a 79 s slot — 80.7% of allocated
        // task time was overhead, and 66% of tasks ran under 15 s. A 30 s poll is
        // sized for a workload this pipeline does not have.
        executor {
            // A finished 1-second job used to sit undetected for a mean of 31 s,
            // holding one of the queueSize slots the whole time.
            pollInterval = '5 sec'

            // Default is 100 and it WAS the binding constraint: in-flight sat at
            // median 77 / max 100, while the QOS that the 10-min and 1-h `-t`
            // values auto-select (`test`, `vshort`) each allow MaxJobsPU = 96 with
            // no cpu/mem MaxTRESPU cap, and the association sets no MaxSubmit. A
            // backlog larger than the running cap is deliberate — it is what
            // refills a slot the instant one frees.
            queueSize = 500

            // sbatch costs ~0.2 s from the single submitter thread (~5 tasks/s of
            // headroom), so submitRateLimit is deliberately left unset.

            dumpInterval = '1 min'
        }
    }
}
