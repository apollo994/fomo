process {
    // Default resource ceiling for a single local dev machine. Process labels
    // below request resources for "ideal" execution; resourceLimits clamps any
    // request down to what this host can actually provide. The `test` profile
    // overrides this with much tighter limits for fast smoke tests.
  	// resourceLimits = [
  	//     cpus:   10,
  	//     memory: 16.GB,
  	//     time:   2.h
  	// ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 10.minutes  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1                  }
        memory = { 6.GB  * task.attempt }
        time   = { 10.minutes   * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 10.minutes    * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}
