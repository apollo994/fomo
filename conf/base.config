// Every resource request, by label. Memory and time grow with task.attempt, so a task killed for
// memory (137) or time (143) retries larger; cpus never grow, since more cores fix neither.
// Rationale: plans/13, plans/24.
process {
    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 10.minutes * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 10.minutes * task.attempt }
    }
    withLabel: process_low {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 15.minutes * task.attempt }
    }
    // Indexing with -x splice needs ~10 GB per Gb of genome, whatever the thread count (minimap2
    // indexes with at most three threads).
    withLabel: process_index {
        cpus   = 3
        memory = { 32.GB * task.attempt }
        time   = { 1.h * task.attempt }
    }
    // One alignment per (target, gene type) covers every source; its memory follows the target
    // genome size, so each retry doubles it. minimap2 gets `-t 2`, samtools sort `-@ 1`.
    withLabel: process_align {
        cpus       = 2
        memory     = { 24.GB * Math.pow(2, task.attempt - 1) }
        time       = { 1.h * task.attempt }
        maxRetries = 2
    }

    // One task digests every MultiQC input of the run; large runs stage tens of thousands of files.
    withName: '.*:RUN_SUMMARY_TABLES$' {
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }
}
