process {
    // No global resourceLimits here: SLURM enforces node limits on the cluster,
    // and profile-level resourceLimits cannot override this block. Tight ceilings
    // live in test.config (CI/smoke tests) and can be added to a local profile if
    // needed for laptop dev.

    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 10.minutes  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // Tiers below were right-sized from execution traces of two completed Lycaenidae
    // targets (1424 tasks each, zero retries) — see plans/13_resource_rightsizing.md.
    // The `* task.attempt` multipliers are what makes tight tiers recoverable: an OOM
    // (137) or time-limit kill (143) retries at 2x/3x/4x via errorStrategy above, so
    // keep them on every memory/time value. `cpus` deliberately does NOT escalate, on
    // any tier — more cores never fix an OOM or a time-limit kill, and a bigger request
    // only waits longer in the SLURM queue (plans/24: three tiers used to escalate, so an
    // OOM retry of MINIMAP2_ALIGN asked for 8, then 12 cpus).
    withLabel: process_single {
        cpus   = { 1                  }
        memory = { 2.GB  * task.attempt }        // was 6.GB — worst observed peak 0.78 GB (GFFCOMPARE_COMBINE)
        time   = { 10.minutes   * task.attempt } // unchanged — sane floor for a SLURM job
    }
    withLabel: process_low {
        cpus   = { 1                    }        // was 2 * task.attempt — worst observed 1.00 core
        memory = { 4.GB  * task.attempt }        // was 12.GB — worst observed peak 0.23 GB (GFFREAD)
        time   = { 15.minutes    * task.attempt } // was 10.minutes — GFFREAD hit 33 s, headroom for larger clades
    }
    withLabel: process_medium {
        // Only MINIMAP2_ALIGN uses this label, and its cpus are overridden to 2 below
        // (plans/24). Memory scales with *target genome size* (a ~3 Gb genome needs
        // 25-30 GB, vs. 6.8 GB peak for ~0.5 Gb Lycaenidae assemblies). Trim it per clade
        // with a run-level `-c` file, never here. See plans/13 constraint 3 + step 6.
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 20.minutes * task.attempt }   // was 1.h — longest observed 89 s; better SLURM backfill
    }
    withLabel: process_high {
        // Used only by the two plans/18 batch processes, which override cpus/memory below.
        cpus   = 12
        memory = { 72.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // plans/18 gave GFF_STATS_PROJECTED_BATCH and GFFCOMPARE_BATCH process_high as a
    // placeholder, to be trimmed from real numbers. plans/24 (apiaceae, T = 35): peak
    // RSS 0.15 GB / 0.73 GB with 12 workers, ~1-3 cores busy, and a median ~7 min SLURM
    // queue wait for the 12 cpu / 72 GB request. 4 cpus keep the `xargs -P ${task.cpus}`
    // loop parallel for large S. task.cpus is in the command line, so this re-hashes them.
    withName: '.*:(GFF_STATS_PROJECTED_BATCH|GFFCOMPARE_BATCH)' {
        cpus   = 4
        memory = { 4.GB * task.attempt }
    }

    // MINIMAP2_ALIGN aligns EVERY source in one task since the single-mapping
    // redesign (plans/15), so its wall time scales with the total read count where it
    // used to scale with one source's. Measured on the Lycaenidae test set: the
    // longest per-source alignment was 10.5 s, the longest merged one 21.2 s for
    // S = 2 — i.e. roughly linear in S, so a 20-source clade wants ~20x the old
    // budget. process_medium's 20 min would likely still hold, but it is the wrong
    // thing to bet a long run on; take the pre-plans/13 hour back for this process
    // only, rather than for everything sharing the label.
    //
    // Memory deliberately NOT raised: peak RSS barely moved when merging (2.5 GB
    // per-source max -> 2.6 GB merged, both on the mRNA track), which confirms it is
    // dominated by the target index rather than the read set. A ~3 Gb genome still
    // needs the per-clade `-c` treatment described in trap (2) below.
    //
    // cpus = 2 (process_medium's 4, before plans/24): on apiaceae the 4-cpu task averaged
    // ~1 core, and even the 14.7 Gb mollusca target used 2.65. `-t 2` still lets minimap2
    // run 3 threads (it adds an I/O thread) and gives `samtools sort` -@ 1.
    // Trap (1) below applies: conf/crg.config's MINIMAP2_ALIGN block sets memory and
    // maxRetries only, so this does not shadow it. Add any environment-specific override
    // THERE, not here.
    withName: '.*:MINIMAP2_ALIGN' {
        cpus = 2
        time = { 1.h * task.attempt }
    }

    // ── Two traps if you add more `withName` blocks here ───────────────────────────────
    // 1. nextflow.config includes conf/crg.config (inside `profiles`) BEFORE this file, and
    //    when two `withName` selectors both match a process the LATER declaration wins —
    //    regardless of which is more specific. So a broad selector added here silently
    //    overrides the narrow one in the crg profile. Verified: a
    //    `withName: '.*:MINIMAP2_INDEX' { memory = 12.GB }` here resolved MINIMAP2_INDEX to
    //    12 GB under `-profile crg`, defeating that profile's deliberate 32 GB. Put
    //    environment-specific overrides in conf/crg.config or a run-level `-c` file instead.
    // 2. Consequence of (1) for minimap2: MINIMAP2_INDEX is `process_low`, so outside
    //    `-profile crg` it now gets 4 GB (was 12 GB). Fine for `-profile test` (capped at
    //    4 GB anyway) and for the Lycaenidae-scale genomes here, but a full-size run on any
    //    other executor must pass its own minimap2 memory via `-c` — indexing a ~3 Gb genome
    //    with `-x splice` needs 25-30 GB. See plans/13 constraint 3 and step 6.
}
