process {
    // No global resourceLimits here: SLURM enforces node limits on the cluster,
    // and profile-level resourceLimits cannot override this block. Tight ceilings
    // live in test.config (CI/smoke tests) and can be added to a local profile if
    // needed for laptop dev.

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 10.minutes  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { 1                  }
        memory = { 6.GB  * task.attempt }
        time   = { 10.minutes   * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 10.minutes    * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 24.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
}
