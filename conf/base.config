process {
    // No global resourceLimits: profiles set them (conf/test.config, conf/crg.config).
    cpus   = 1
    memory = { 6.GB * task.attempt }
    time   = { 10.minutes * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 3
    maxErrors     = '-1'

    // Memory and time grow with task.attempt, so a task killed for memory (137) or time (143)
    // retries larger; cpus never grow, since more cores fix neither. Rationale: plans/13, plans/24.
    withLabel: process_single {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 10.minutes * task.attempt }
    }
    withLabel: process_low {
        cpus   = { 1 }
        memory = { 4.GB * task.attempt }
        time   = { 15.minutes * task.attempt }
    }
    withLabel: process_medium {
        // MINIMAP2_ALIGN only. Its memory follows the target genome size: size large
        // genomes with a run-level `-c` file.
        cpus   = 4
        memory = { 24.GB * task.attempt }
        time   = { 20.minutes * task.attempt }
    }
    withLabel: process_high {
        cpus   = 12
        memory = { 72.GB * task.attempt }
        time   = { 2.h * task.attempt }
    }

    // The two per-target batch processes loop over every source with `xargs -P`. xargs reports
    // a failed or killed worker as 123 or 125, so those exit codes are retried here too.
    withName: '.*:(GFF_STATS_PROJECTED_BATCH|GFFCOMPARE_BATCH)' {
        cpus          = 4
        memory        = { 4.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + [104, 123, 125]) ? 'retry' : 'finish' }
    }

    // One alignment per (target, gene type) covers every source, so its time grows with the
    // number of sources; minimap2 gets `-t 2`, samtools sort `-@ 1`.
    withName: '.*:MINIMAP2_ALIGN' {
        cpus = 2
        time = { 1.h * task.attempt }
    }

    // When two withName selectors match a process the later one wins, whatever their
    // specificity, and this file is included after the profiles: put site-specific overrides
    // in conf/crg.config or a run-level `-c` file, not here. MINIMAP2_INDEX outside
    // `-profile crg` gets process_low's 4 GB; a ~3 Gb genome needs 25-30 GB.
}
