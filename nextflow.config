manifest {
    name        = 'run_BUSCO'
    version     = '1.0.0'
    description = 'Run BUSCO in transcriptome mode on genome annotation mRNA FASTA files'
}

params {
    input       = "${projectDir}/assets/input/*_mRNA_*.mrna.fa"
    outdir      = "${projectDir}/results"
    publish_dir = true
    lineage     = 'lepidoptera_odb12'
    busco_mode  = 'transcriptome'
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '1 GB'
    time     = '1h'

    withName: 'BUSCO_DOWNLOAD' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
        publishDir = [
            path: "${params.outdir}/busco_downloads",
            mode: 'copy',
            enabled: params.publish_dir
        ]
    }

    withName: 'BUSCO_BUSCO' {
        cpus   = 8
        memory = '16 GB'
        time   = '4h'
        publishDir = [
            path: "${params.outdir}/busco",
            mode: 'copy',
            enabled: params.publish_dir,
            saveAs: { fn -> fn.startsWith('busco_downloads') ? null : fn }
        ]
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
    }

    conda {
        conda.enabled = true
    }

    crg {
        params {
            config_profile_description = 'CRG HPC cluster profile'
        }

        process {
            executor = 'slurm'
            queue    = 'genoa64'
            cache    = 'lenient'
        }

        apptainer {
            enabled    = true
            autoMounts = true
        }

        executor.pollInterval = '30 sec'
    }
}
