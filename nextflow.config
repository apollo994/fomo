manifest {
    name            = 'fomo'
    description     = 'Annotates candidate lncRNAs on a target assembly by transferring annotation from source species'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0dev'
}

plugins {
    id 'nf-schema@2.3.0'
}

validation {
    // Abort if an unrecognised --param is passed (catches typos like
    // --decoy_capp). Every user-facing param must exist in nextflow_schema.json.
    failUnrecognisedParams = true
    // Profile-metadata params set by institutional/test configs — not pipeline
    // inputs, so excused from schema validation rather than added to the schema.
    defaultIgnoreParams = ['config_profile_name', 'config_profile_description']
    help {
        enabled = true
    }
}

params {
    input            = null
    outdir           = 'results'
    publish_dir_mode = 'copy'
    relocate_seed    = 42
    decoy_cap        = 1000
    include_mrna            = false
    include_decoy           = false
    include_single_exon     = false
    longest_isoform         = true
    curate                  = true
    curate_min_species      = 2
    td2_psauron_min         = 0.5
    multiqc_main_config     = "${projectDir}/assets/multiqc/main.yml"
    multiqc_sections_config = "${projectDir}/assets/multiqc/sections.yml"
    // Same split for the run-level report (one per run, published under
    // ${outdir}/summary/) — layout in one file, custom_data/sp in the other.
    multiqc_run_summary_main_config     = "${projectDir}/assets/multiqc/run_summary_main.yml"
    multiqc_run_summary_sections_config = "${projectDir}/assets/multiqc/run_summary_sections.yml"
}

// Result publishing lives in conf/modules.config (bottom section), grouped by destination
// directory. Only deliverable processes publish. publishDir's `enabled` takes a static boolean
// only: select processes with `withName` instead.

// conda is used only under `-profile conda`.
conda.channels = ['conda-forge', 'bioconda']

profiles {
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'

        // bin/gff-feature-stats is an x86-64 binary: on arm64 hosts run the processes that use
        // it from the amd64 image variant (a no-op on x86-64).
        process {
            withName: '.*:GFF_STATS(_TARGET|_PROJECTED_BATCH)?$' {
                containerOptions = '--platform=linux/amd64'
            }
        }
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    crg {
        includeConfig 'conf/crg.config'
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Execution reports under ${params.outdir}/pipeline_info/, overwritten by each run.
// IO counters and peak_rss are only populated on Linux.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,' +
              'cpus,memory,time,duration,realtime,%cpu,%mem,rss,vmem,' +
              'peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes'
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
