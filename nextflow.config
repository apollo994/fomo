manifest {
    name            = 'fomo'
    description     = 'Annotates candidate lncRNAs on a target assembly by transferring annotation from source species'
    homePage        = 'https://github.com/apollo994/fomo'
    defaultBranch   = 'main'
    contributors    = [
        [name: 'Fabio Zanarello', affiliation: 'Centre for Genomic Regulation (CRG)', github: 'https://github.com/apollo994', contribution: ['author', 'maintainer']]
    ]
    nextflowVersion = '!>=25.04.0'
    version         = '0.1.0dev'
}

plugins {
    id 'nf-schema@2.3.0'
}

validation {
    // Every user-facing param must exist in nextflow_schema.json: a typo such as --decoy_capp
    // aborts the run.
    failUnrecognisedParams = true
    // Profile metadata, not pipeline inputs.
    defaultIgnoreParams = ['config_profile_name', 'config_profile_description']
    help {
        enabled = true
    }
}

params {
    input            = null
    outdir           = 'results'
    publish_dir_mode = 'copy'
    // Suffix of the pipeline_info file names: each run keeps its own reports.
    trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
    relocate_seed    = 42
    decoy_cap        = 1000
    include_mrna            = false
    include_decoy           = false
    include_single_exon     = false
    longest_isoform         = true
    curate                  = true
    curate_min_species      = 2
    td2_psauron_min         = 0.5
    // MultiQC configs, layout and sections in separate files: per-target reports, then the run
    // summary.
    multiqc_main_config     = "${projectDir}/assets/multiqc/main.yml"
    multiqc_sections_config = "${projectDir}/assets/multiqc/sections.yml"
    multiqc_run_summary_main_config     = "${projectDir}/assets/multiqc/run_summary_main.yml"
    multiqc_run_summary_sections_config = "${projectDir}/assets/multiqc/run_summary_sections.yml"
}

// Resources, then images; profiles may override both. conf/modules.config holds only ext.* and
// publishDir (result publishing at its bottom).
includeConfig 'conf/base.config'
includeConfig 'conf/containers.config'

profiles {
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'

        // bin/gff-feature-stats is an x86-64 binary: on arm64 hosts run the processes that use
        // it from the amd64 image variant (a no-op on x86-64).
        process {
            withLabel: 'amd64_only' {
                containerOptions = '--platform=linux/amd64'
            }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    crg {
        includeConfig 'conf/crg.config'
    }
}

includeConfig 'conf/modules.config'

// Execution reports, one set per run. IO counters and peak_rss are only populated on Linux.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,' +
              'cpus,memory,time,duration,realtime,%cpu,%mem,rss,vmem,' +
              'peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}
