manifest {
    name            = 'fomo'
    description     = 'Annotates candidate lncRNAs on a target assembly by transferring annotation from source species'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0dev'
}

plugins {
    id 'nf-schema@2.3.0'
}

validation {
    // Abort if an unrecognised --param is passed (catches typos like
    // --decoy_capp). Every user-facing param must exist in nextflow_schema.json.
    failUnrecognisedParams = true
    // Profile-metadata params set by institutional/test configs — not pipeline
    // inputs, so excused from schema validation rather than added to the schema.
    defaultIgnoreParams = ['config_profile_name', 'config_profile_description']
    help {
        enabled = true
    }
}

params {
    input            = null
    outdir           = 'results'
    publish_dir_mode = 'copy'
    relocate_seed    = 42
    decoy_cap        = 1000
    include_single_exon     = false
    top_consensus_n         = 3
    td2_psauron_min         = 0.5
    multiqc_main_config     = "${projectDir}/assets/multiqc/main.yml"
    multiqc_sections_config = "${projectDir}/assets/multiqc/sections.yml"
}

process {
    publishDir = [
        path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode:    params.publish_dir_mode,
        saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
    ]
}

// conda is enabled alongside the container engines so TD2_PREDICT can run from
// its `conda` directive (bioconda::td2, a noarch package). EXECUTION is correct:
// every process that defines a `container` runs in the container engine (docker
// locally, singularity on CRG) — only TD2 (conda-only) executes via conda.
// CAVEAT: with conda.enabled global, Nextflow also *builds* conda envs for the
// nf-core modules that ship a `conda` directive (even though they run in their
// containers). Those envs are unused but get created/cached. To be evaluated on
// the cluster — if the extra env builds are a problem there, revisit (e.g. pin a
// conda.cacheDir, or containerise TD2).
conda.enabled  = true
conda.channels = ['conda-forge', 'bioconda']

profiles {
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
	crg {
		includeConfig 'conf/crg.config'
	}
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
