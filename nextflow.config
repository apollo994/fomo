manifest {
    name        = 'fomo'
    version     = '1.0.0'
    description = 'Run BUSCO in transcriptome mode on genome annotation mRNA FASTA files'
}

params {
    input                = "${projectDir}/assets/input/*.mrna.fa"
    outdir               = "${projectDir}/results"
    lineage              = 'lepidoptera_odb12'
    busco_mode           = 'transcriptome'
    busco_lineages_path  = null
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '1 GB'
    time     = '1h'

    withName: 'BUSCO_DOWNLOAD' {
        cpus   = 1
        memory = '16 GB'
        time   = '1h'
        publishDir = [ enabled: false ]
    }

    withName: 'BUSCO_BUSCO' {
        array         = 1000
        cpus          = { 4 * task.attempt }
        time          = 20.min 
        memory        = { 4.GB * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
        maxRetries    = 2
        publishDir = [
            path: "${params.outdir}/busco",
            mode: 'copy',
            saveAs: { fn -> fn.matches('short_summary\\..*\\.json') ? fn : null }
        ]
    }
}

profiles {
    standard {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
    }

    conda {
        conda.enabled = true
    }

    crg {
        params {
            config_profile_description = 'CRG HPC cluster profile'
        }

        process {
            executor = 'slurm'
            queue    = 'genoa64'
            cache    = 'lenient'
        }

        apptainer {
            enabled    = true
            autoMounts = true
        }

        executor.pollInterval = '30 sec'
    }
}
