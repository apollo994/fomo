manifest {
    name            = 'fomo'
    description     = 'Annotates candidate lncRNAs on a target assembly by transferring annotation from source species'
    nextflowVersion = '!>=24.10.0'
    version         = '0.1.0dev'
}

plugins {
    id 'nf-schema@2.3.0'
}

validation {
    // Abort if an unrecognised --param is passed (catches typos like
    // --decoy_capp). Every user-facing param must exist in nextflow_schema.json.
    failUnrecognisedParams = true
    // Profile-metadata params set by institutional/test configs — not pipeline
    // inputs, so excused from schema validation rather than added to the schema.
    defaultIgnoreParams = ['config_profile_name', 'config_profile_description']
    help {
        enabled = true
    }
}

params {
    input            = null
    outdir           = 'results'
    publish_dir_mode = 'copy'
    relocate_seed    = 42
    decoy_cap        = 1000
    include_single_exon     = false
    top_consensus_n         = 3
    td2_psauron_min         = 0.5
    multiqc_main_config     = "${projectDir}/assets/multiqc/main.yml"
    multiqc_sections_config = "${projectDir}/assets/multiqc/sections.yml"
}

// ── Result publishing (opt-in) ───────────────────────────────────────────────
// Only the deliverable processes below publish to ${params.outdir}; every other
// process has NO publishDir rule, so not even an empty folder is created.
// NOTE: publishDir's `enabled` only honours a STATIC boolean — a closure is not
// evaluated per-task and silently disables publishing for everything. So we
// select processes with a withName selector (each gets a default-enabled rule)
// rather than a dynamic `enabled`. The `$`-anchored alternation matches e.g.
// `:GFFCOMPARE` but not `:GFFCOMPARE_COMBINE(_TOP)`, leaving the intermediate
// combine steps unpublished. Suppressing publishDir never affects execution —
// downstream processes (incl. MultiQC) read inputs from work/ via channels.
// (pipeline_info publishes via the report/trace/timeline/dag scopes, separately.)
process {
    withName: '.*:(MULTIQC|COMBINED_GTF_TO_GFF|COMBINED_TOP_GTF_TO_GFF|GFFCOMPARE|GFFCOMPARE_TOP|BAM_TO_GFF|MINIMAP2_ALIGN|SELECT_TOP_SOURCES)$' {
        publishDir = [
            path:    { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
            mode:    params.publish_dir_mode,
            saveAs:  { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

// conda is NO LONGER enabled globally. It used to be, because TD2_PREDICT was the
// one process without a container and had to run from its `conda` directive; that
// also made Nextflow build (and cache) unused conda envs for every nf-core module
// shipping a `conda` directive, and it let the host's ~/.local user-site shadow the
// env's packages. TD2 now has a Wave-built container like every other process, so
// conda is only used under `-profile conda`. The channel list stays for that path.
conda.channels = ['conda-forge', 'bioconda']

profiles {
    docker {
        docker.enabled     = true
        docker.runOptions  = '-u $(id -u):$(id -g)'
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        includeConfig 'conf/test.config'
    }
	crg {
		includeConfig 'conf/crg.config'
	}
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Execution resource reporting ─────────────────────────────────────────────
// Four always-on reports written to ${params.outdir}/pipeline_info/ with
// timestamps so every run (local and CRG) keeps its own history.
// Note: macOS kernel IO counters (read_bytes/write_bytes, peak_rss) may show
// '-' locally but populate fully on Linux/SLURM runs where sizing matters.
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,attempt,' +
              'cpus,memory,time,duration,realtime,%cpu,%mem,rss,vmem,' +
              'peak_rss,peak_vmem,rchar,wchar,read_bytes,write_bytes'
    overwrite = true
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
    overwrite = true
}
